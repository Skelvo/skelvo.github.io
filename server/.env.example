# Copie ce fichier en ".env" et remplis-le.
# Génère des clés avec :  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Clé du tracker (écriture des positions) — la même que CFG_DEVICE_KEY dans firmware/include/secrets.h
DEVICE_KEY=
# Clé de lecture (celle que tu tapes dans la page web)
READ_KEY=

PORT=3000
DB_PATH=./data/tracker.db

# URL du serveur pour le script de simulation
SIM_URL=http://localhost:3000
