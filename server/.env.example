# Facultatif : tout marche sans ce fichier.
# Pour l'utiliser, copie-le en ".env".

PORT=3000
DB_PATH=./data/tracker.db

# Les clés sont créées automatiquement au premier lancement (npm run keys pour les voir).
# Tu peux les imposer ici si tu préfères :
# DEVICE_KEY=
# READ_KEY=

# Adresse de contact pour les notifications push (demandée par Apple/Google)
# VAPID_SUBJECT=mailto:toi@example.com

# URL du serveur pour le script de simulation
# SIM_URL=http://localhost:3000
